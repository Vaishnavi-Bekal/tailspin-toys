---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const db = getDatabase();
const games = await getAllGames(db);
const categories = await getAllCategories(db);
const publishers = await getAllPublishers(db);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <form class="mb-8 grid grid-cols-1 gap-4 rounded-xl border border-slate-700 bg-slate-800/60 p-5 sm:grid-cols-3 sm:items-end" data-testid="game-filters">
            <div>
              <label for="category-filter" class="mb-2 block text-sm font-medium text-slate-200">Category</label>
              <select id="category-filter" name="category" data-testid="category-filter" class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                <option value="">All categories</option>
                {categories.map((category) => <option value={category.id}>{category.name}</option>)}
              </select>
            </div>
            <div>
              <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-200">Publisher</label>
              <select id="publisher-filter" name="publisher" data-testid="publisher-filter" class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                <option value="">All publishers</option>
                {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
              </select>
            </div>
            <div class="flex items-center justify-between gap-3">
              <p class="text-sm text-slate-300" data-testid="filter-result-count" aria-live="polite">{games.length} games</p>
              <a href="/" data-testid="clear-filters" class="rounded-lg px-3 py-2 text-sm font-medium text-blue-400 hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none">Clear filters</a>
            </div>
          </form>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => (
              <div
                data-game-card-wrapper
                data-testid="game-card-wrapper"
                data-category-id={game.category?.id}
                data-publisher-id={game.publisher?.id}
              >
                <GameCard game={game} />
              </div>
            ))}
          </div>
          <div data-testid="no-filter-results" hidden>
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const categoryFilter = document.querySelector<HTMLSelectElement>('[data-testid="category-filter"]');
  const publisherFilter = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');
  const resultCount = document.querySelector<HTMLElement>('[data-testid="filter-result-count"]');
  const noResults = document.querySelector<HTMLElement>('[data-testid="no-filter-results"]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-game-card-wrapper]')];

  if (categoryFilter && publisherFilter && resultCount && noResults) {
    const params = new URLSearchParams(window.location.search);
    categoryFilter.value = params.get('category') ?? '';
    publisherFilter.value = params.get('publisher') ?? '';

    const applyFilters = (): void => {
      const categoryId = categoryFilter.value;
      const publisherId = publisherFilter.value;
      let visibleCount = 0;

      cards.forEach((card) => {
        const matchesCategory = !categoryId || card.dataset.categoryId === categoryId;
        const matchesPublisher = !publisherId || card.dataset.publisherId === publisherId;
        const visible = matchesCategory && matchesPublisher;
        card.hidden = !visible;
        if (visible) visibleCount += 1;
      });

      resultCount.textContent = `${visibleCount} ${visibleCount === 1 ? 'game' : 'games'}`;
      noResults.hidden = visibleCount > 0;

      const nextParams = new URLSearchParams();
      if (categoryId) nextParams.set('category', categoryId);
      if (publisherId) nextParams.set('publisher', publisherId);
      const query = nextParams.toString();
      window.history.replaceState({}, '', query ? `/?${query}` : '/');
    };

    categoryFilter.addEventListener('change', applyFilters);
    publisherFilter.addEventListener('change', applyFilters);
    applyFilters();
  }
</script>
